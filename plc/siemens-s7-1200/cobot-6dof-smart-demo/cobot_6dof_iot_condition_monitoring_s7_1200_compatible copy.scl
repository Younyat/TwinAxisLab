// S7-1200 / TIA Portal SCL - compatible with the existing variable names.
// This is a replacement body for the code shown in
// cobot_6dof_iot_condition_monitoring_s7_1200 copy.scl.
// It uses no SegmentStartJ*, PreviousStep, PreviousP or ProgramSignature.

#TemperatureC := INT_TO_REAL("RobotHolding".Struct.TemperatureCx100) / 100.0;
#HumidityRH := UINT_TO_REAL("RobotHolding".Struct.HumidityRHx100) / 100.0;
#GyroDps := UINT_TO_REAL("RobotHolding".Struct.GyroDpsx100) / 100.0;
#MotionPresent := #GyroDps >= 3.0;

#MotionIdleTimer(
    IN := ("RobotHolding".Struct.SensorPolicy = 1) AND (NOT #MotionPresent),
    PT := T#2s
);

"RobotHolding".Struct.ConditionState := 0;
"RobotHolding".Struct.AlarmCode := 0;
#MotionScale := 1.0;
"RobotHolding".Struct.SpeedPermille := 1000;

IF ("RobotHolding".Struct.SensorValid = 0)
    OR (("RobotHolding".Struct.SensorQualityBits AND UINT#1) = UINT#0)
    OR ("RobotHolding".Struct.SensorAgeMs > 2500)
THEN
    "RobotHolding".Struct.ConditionState := 3;
    "RobotHolding".Struct.AlarmCode := 4;
    #MotionScale := 0.0;
    "RobotHolding".Struct.SpeedPermille := 0;
ELSIF ("RobotHolding".Struct.SensorPolicy = 1)
    AND (("RobotHolding".Struct.SensorQualityBits AND UINT#16) = UINT#0)
THEN
    "RobotHolding".Struct.ConditionState := 3;
    "RobotHolding".Struct.AlarmCode := 6;
    #MotionScale := 0.0;
    "RobotHolding".Struct.SpeedPermille := 0;
ELSIF ("RobotHolding".Struct.SensorPolicy = 1) AND #MotionIdleTimer.Q THEN
    "RobotHolding".Struct.ConditionState := 2;
    "RobotHolding".Struct.AlarmCode := 5;
    #MotionScale := 0.0;
    "RobotHolding".Struct.SpeedPermille := 0;
ELSIF (#TemperatureC >= 55.0) OR (#HumidityRH >= 85.0) OR (#GyroDps >= 220.0) THEN
    "RobotHolding".Struct.ConditionState := 2;
    #MotionScale := 0.0;
    "RobotHolding".Struct.SpeedPermille := 0;
    IF #TemperatureC >= 55.0 THEN
        "RobotHolding".Struct.AlarmCode := 1;
    ELSIF #HumidityRH >= 85.0 THEN
        "RobotHolding".Struct.AlarmCode := 2;
    ELSE
        "RobotHolding".Struct.AlarmCode := 3;
    END_IF;
ELSIF (#TemperatureC >= 45.0) OR (#HumidityRH >= 75.0) OR (#GyroDps >= 120.0) THEN
    "RobotHolding".Struct.ConditionState := 1;
    #MotionScale := 0.55;
    "RobotHolding".Struct.SpeedPermille := 550;
END_IF;

IF "RobotHolding".Struct.Command = 2 THEN
    #TimerEnabled := FALSE;
    #ResetTimer := TRUE;
    "RobotHolding".Struct.Status := 2;
    "RobotHolding".Struct.ActiveStep := 0;
    "RobotHolding".Struct.ElapsedMsOut := 0;
    #J1Deg := 0.0; #J2Deg := -35.0; #J3Deg := 75.0;
    #J4Deg := 50.0; #J5Deg := 0.0; #J6Deg := 0.0;
ELSIF "RobotHolding".Struct.Command = 0 THEN
    #TimerEnabled := FALSE;
    #ResetTimer := TRUE;
    "RobotHolding".Struct.Status := 0;
    "RobotHolding".Struct.ActiveStep := 0;
    "RobotHolding".Struct.ElapsedMsOut := 0;
ELSIF "RobotHolding".Struct.ConditionState >= 2 THEN
    #TimerEnabled := FALSE;
    #ResetTimer := TRUE;
    "RobotHolding".Struct.Status := 3;
    "RobotHolding".Struct.ActiveStep := 0;
ELSE
    "RobotHolding".Struct.Status := 1;
    IF #ResetTimer THEN
        #TimerEnabled := FALSE;
        #ResetTimer := FALSE;
    ELSE
        #TimerEnabled := TRUE;
    END_IF;
END_IF;

#CycleTimer(IN := #TimerEnabled, PT := T#10s);

IF "RobotHolding".Struct.Status = 1 THEN
    #ElapsedMs := TIME_TO_DINT(#CycleTimer.ET);
    IF #ElapsedMs > 10000 THEN #ElapsedMs := 10000; END_IF;
    "RobotHolding".Struct.ElapsedMsOut := DINT_TO_UINT(#ElapsedMs);

    IF #ElapsedMs < 1400 THEN
        "RobotHolding".Struct.ActiveStep := 1;
        #SegmentStartMs := 0; #SegmentDurationMs := 1400;
        #TargetJ1 := -55.0; #TargetJ2 := -10.0; #TargetJ3 := 85.0;
        #TargetJ4 := 25.0; #TargetJ5 := 0.0; #TargetJ6 := 0.0;
    ELSIF #ElapsedMs < 2400 THEN
        "RobotHolding".Struct.ActiveStep := 2;
        #SegmentStartMs := 1400; #SegmentDurationMs := 1000;
        #TargetJ1 := -55.0; #TargetJ2 := 15.0; #TargetJ3 := 80.0;
        #TargetJ4 := -5.0; #TargetJ5 := 0.0; #TargetJ6 := 0.0;
    ELSIF #ElapsedMs < 3200 THEN
        "RobotHolding".Struct.ActiveStep := 3;
        #SegmentStartMs := 2400; #SegmentDurationMs := 800;
        #TargetJ1 := -55.0; #TargetJ2 := 15.0; #TargetJ3 := 80.0;
        #TargetJ4 := -5.0; #TargetJ5 := 0.0; #TargetJ6 := 90.0;
    ELSIF #ElapsedMs < 5600 THEN
        "RobotHolding".Struct.ActiveStep := 4;
        #SegmentStartMs := 3200; #SegmentDurationMs := 2400;
        #TargetJ1 := 50.0; #TargetJ2 := -10.0; #TargetJ3 := 85.0;
        #TargetJ4 := 25.0; #TargetJ5 := 0.0; #TargetJ6 := 90.0;
    ELSIF #ElapsedMs < 7600 THEN
        "RobotHolding".Struct.ActiveStep := 5;
        #SegmentStartMs := 5600; #SegmentDurationMs := 2000;
        #TargetJ1 := 50.0; #TargetJ2 := 15.0; #TargetJ3 := 80.0;
        #TargetJ4 := -5.0; #TargetJ5 := 30.0; #TargetJ6 := -90.0;
    ELSE
        "RobotHolding".Struct.ActiveStep := 6;
        #SegmentStartMs := 7600; #SegmentDurationMs := 2400;
        #TargetJ1 := 0.0; #TargetJ2 := -35.0; #TargetJ3 := 75.0;
        #TargetJ4 := 50.0; #TargetJ5 := 0.0; #TargetJ6 := 0.0;
    END_IF;

    #P := DINT_TO_REAL(#ElapsedMs - #SegmentStartMs) / DINT_TO_REAL(#SegmentDurationMs);
    IF #P < 0.0 THEN #P := 0.0; END_IF;
    IF #P > 1.0 THEN #P := 1.0; END_IF;
    #P := #P * #P * (3.0 - (2.0 * #P));

    // Existing names only. Damping prevents burst-like corrections and keeps
    // the pose continuous when MotionScale changes.
    #J1Deg := #J1Deg + ((#TargetJ1 - #J1Deg) * #P * 0.02 * #MotionScale);
    #J2Deg := #J2Deg + ((#TargetJ2 - #J2Deg) * #P * 0.02 * #MotionScale);
    #J3Deg := #J3Deg + ((#TargetJ3 - #J3Deg) * #P * 0.02 * #MotionScale);
    #J4Deg := #J4Deg + ((#TargetJ4 - #J4Deg) * #P * 0.02 * #MotionScale);
    #J5Deg := #J5Deg + ((#TargetJ5 - #J5Deg) * #P * 0.02 * #MotionScale);
    #J6Deg := #J6Deg + ((#TargetJ6 - #J6Deg) * #P * 0.02 * #MotionScale);

    IF #CycleTimer.Q THEN #ResetTimer := TRUE; END_IF;
END_IF;

"RobotHolding".Struct.J1Raw := REAL_TO_INT(#J1Deg * #DegToRadScaled);
"RobotHolding".Struct.J2Raw := REAL_TO_INT(#J2Deg * #DegToRadScaled);
"RobotHolding".Struct.J3Raw := REAL_TO_INT(#J3Deg * #DegToRadScaled);
"RobotHolding".Struct.J4Raw := REAL_TO_INT(#J4Deg * #DegToRadScaled);
"RobotHolding".Struct.J5Raw := REAL_TO_INT(#J5Deg * #DegToRadScaled);
"RobotHolding".Struct.J6Raw := REAL_TO_INT(#J6Deg * #DegToRadScaled);
