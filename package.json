    "test:responsive": "node scripts/regression-responsive-layout.mjs",
    "test:articulation": "node scripts/regression-articulation.mjs",
    "test:parts": "node scripts/regression-parts-selection.mjs",
    "test:kinematics": "node scripts/kinematics-tests.mjs",
