    "test:ux": "node scripts/kinematics-ux.mjs",
    "test:piece-mode": "node scripts/piece-analysis-e2e.mjs",
    "test:cell-rigs": "node scripts/regression-cell-rigs.mjs",
    "test:old-robots": "node scripts/regression-old-robots.mjs",
