    "docs:capture:piece-motion": "node scripts/capture-piece-motion-gif.mjs",
    "docs:capture:arm-model": "node scripts/capture-arm-model-gif.mjs",
    "docs:capture:robot-arm-motion": "node scripts/capture-robot-arm-motion-gif.mjs",
    "test:all": "npm.cmd run test:branding && npm.cmd run test:twin && npm.cmd run test:modbus-driver && npm.cmd run test:modbus-controller && npm.cmd run test:modbus-bridge && npm.cmd run test:kinematics && node scripts/m2-kinematics-tests.mjs --defer-regression && npm.cmd run test:kinematics:e2e && npm.cmd run test:rig:advanced && npm.cmd run test:ux && npm.cmd run test:piece-mode && npm.cmd run test:cell-rigs && npm.cmd run test:old-robots && npm.cmd run test:industrial-scene && npm.cmd run test:plc-dashboard && npm.cmd run test:articulation && npm.cmd run test:parts && npm.cmd run test:render && npm.cmd run test:responsive && node scripts/m2-kinematics-tests.mjs --full-regression-passed",
